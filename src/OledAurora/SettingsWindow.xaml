<Window x:Class="OledAurora.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:OledAurora"
 Title="OLED Aurora" Width="640" Height="860" MinWidth="550" MinHeight="580"
 Background="#161C25" Foreground="#E8EDF4" FontFamily="Segoe UI" FontSize="14"
 WindowStartupLocation="CenterScreen" Icon="Assets/aurora.ico">
 <DockPanel Margin="28,22,28,20">
  <StackPanel DockPanel.Dock="Top">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="OLED Aurora" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Мягкое движение поверх рабочего стола" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
    <Border Grid.Column="1" CornerRadius="6" Background="#273D3C" Padding="10,5" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Foreground="#B4DCD1" FontSize="12"/></Border>
   </Grid>
   <Border Background="#202631" CornerRadius="8" Margin="0,20,0,16" Height="74" ClipToBounds="True">
    <Grid><TextBlock Text="Спокойный фон. Привычный рабочий ритм." Foreground="#C5CEDB" Margin="16,0" VerticalAlignment="Center"/><local:AuroraVisual x:Name="MiniPreview"/></Grid>
   </Border>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="StatusLabel" Foreground="#B4DCD1" Margin="0,12,0,10" AutomationProperties.LiveSetting="Polite"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button Content="Показать анимацию" Click="PreviewClick"/>
    <Button Grid.Column="2" Content="Сохранить и свернуть" Background="#98CCBF" Foreground="#152A24" Click="SaveClick"/>
   </Grid>
   <TextBlock Text="Закрытие окна оставляет приложение в трее. Выход — через значок рядом с часами." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,10,0">
    <TextBlock Text="МОНИТОР" Style="{StaticResource Label}"/>
    <ComboBox x:Name="MonitorBox" DisplayMemberPath="Label" SelectedValuePath="DeviceName"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Высота верхней области"/><TextBlock Grid.Column="1" x:Name="CoverageLabel" Foreground="{StaticResource Muted}"/></Grid>
    <Slider x:Name="CoverageSlider" Minimum="5" Maximum="40" TickFrequency="1" ValueChanged="ValueChanged" AutomationProperties.Name="Высота верхней области"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Непрозрачность"/><TextBlock Grid.Column="1" x:Name="OpacityLabel" Foreground="{StaticResource Muted}"/></Grid>
    <Slider x:Name="OpacitySlider" Minimum="5" Maximum="80" TickFrequency="1" ValueChanged="ValueChanged" AutomationProperties.Name="Непрозрачность"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="ДЛИТЕЛЬНОСТЬ" Style="{StaticResource Label}"/><TextBlock x:Name="DurationLabel"/><Slider x:Name="DurationSlider" Minimum="2" Maximum="20" TickFrequency="1" ValueChanged="ValueChanged" AutomationProperties.Name="Длительность анимации"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="ИНТЕРВАЛ" Style="{StaticResource Label}"/><TextBlock x:Name="IntervalLabel"/><Slider x:Name="IntervalSlider" Minimum="30" Maximum="600" TickFrequency="15" ValueChanged="ValueChanged" AutomationProperties.Name="Интервал анимации"/></StackPanel>
    </Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="АНИМАЦИЯ" Style="{StaticResource Label}"/><ComboBox x:Name="PaletteBox" SelectionChanged="PaletteChanged"><ComboBoxItem Content="Холодное сияние"/><ComboBoxItem Content="Дымчатая волна"/><ComboBoxItem Content="Северное сияние"/></ComboBox></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="ПЛАВНОСТЬ" Style="{StaticResource Label}"/><ComboBox x:Name="FpsBox"><ComboBoxItem Content="30 кадров/с"/><ComboBoxItem Content="60 кадров/с"/></ComboBox></StackPanel>
    </Grid>
    <CheckBox x:Name="EnabledBox" Content="Запускать по расписанию"/>
    <CheckBox x:Name="FullscreenBox" Content="Пауза в полноэкранных приложениях"/>
    <CheckBox x:Name="StartupBox" Content="Запускать при входе в Windows"/>
    <TextBlock Text="Ctrl + Alt + F10 — показать анимацию&#10;Ctrl + Alt + F11 — пауза / продолжить" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,6"/>
    <TextBlock x:Name="WarningLabel" Foreground="#E2BE8A" FontSize="12" Margin="0,5,0,4"/>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
