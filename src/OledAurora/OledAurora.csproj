<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns the application/DPI context; WinForms supplies only Screen and NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>OledAurora</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/aurora.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OledAurora.Core/OledAurora.Core.csproj" />
    <Resource Include="Assets/aurora.ico" />
  </ItemGroup>
</Project>
